{
  "extends": "@vesper/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist/src",
    "rootDir": "./src",
    "declarationMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@vesper/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
