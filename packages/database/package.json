{
  "name": "@vesper/database",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && pnpm copy:migrations",
    "dev": "concurrently \"tsc -b --watch\" \"cpx 'drizzle/**/*' dist/drizzle --watch\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "copy:migrations": "cpx \"drizzle/**/*\" dist/drizzle",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vesper/types": "workspace:*",
    "abitype": "^1.2.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@vesper/eslint-config": "workspace:*",
    "concurrently": "^9.2.1",
    "cpx2": "^8.0.0",
    "typescript-eslint": "^8.56.1"
  }
}
