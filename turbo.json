{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "cache": false,
      "inputs": ["src/**/*.ts", "drizzle.config.ts"],
      "outputs": ["drizzle/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@vesper/api#dev": {
      "dependsOn": ["@vesper/database#db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    }
  }
}
